# Optional: without a key, PDF extraction still works using rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=12
# Additional frontend origins, separated by commas. No trailing slash.
CORS_ORIGINS=
# Public project identifier; no service-account credential is needed to verify signatures.
FIREBASE_PROJECT_ID=syllabot-unmsm
# Additional API hostnames only when using a custom domain.
ALLOWED_API_HOSTS=
